# Sovereign Terminal Environment Configuration
# Default Dev Port: 2068 | Production Release Port: 2069
PORT=2069
WORKSPACE_ROOT=/workspace

# Authentication & Security Configuration
# Set ENABLE_AUTH=true to enforce password authentication modal, session cookies, and route protection
ENABLE_AUTH=true
SERVER_AUTH_TOKEN=change_this_to_your_secure_token
SUDO_MACRO_SECRET=your_secure_sudo_password
TMUX_SOCKET_PATH=/tmp/tmux-1000/default

# Deployment Mode Configuration ('sandbox' | 'baremetal')
DEPLOYMENT_MODE=sandbox

# HTTPS / SSL Security Configuration
# Set ENABLE_HTTPS=true to auto-generate self-signed SSL certificates and run on https://
# This unlocks WebSpeech voice dictation and native camera/mic browser APIs over LAN IP.
ENABLE_HTTPS=false
SSL_ORGANIZATION=OmniState

# Timezone Configuration (e.g. America/Chicago, America/New_York, Europe/Oslo, etc.)
TZ=America/Chicago

# File Deletion Safety Configuration
# Default: SAFE_TRASH_MODE=true moves deleted items to ./_temp_trash/
# Set ENABLE_PERMANENT_DELETE=true or SAFE_TRASH_MODE=false to allow permanent file removal
SAFE_TRASH_MODE=true
ENABLE_PERMANENT_DELETE=false
TRASH_DIR=/workspace/_temp_trash
