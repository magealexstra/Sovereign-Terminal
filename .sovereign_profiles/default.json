    "label": "CUST",
    "value": "50"
  },
  "copyDestination": "clip",
  "buttons": [
    {
      "id": "default-esc",
      "label": "ESC",
      "value": "\u001b",
      "width": 2.4,
      "height": 2,
      "shape": "rounded",
