# Sovereign Terminal Environment Configuration
# Default Port: 2069
PORT=2069
# SOVEREIGN_ROOT is optional. Defaults to $HOME if not set.
# Set this to override the root directory for the file browser and terminal sessions.
# Docker deployments set this automatically — do not set it here for Docker use.
# SOVEREIGN_ROOT=/home/user/projects

# Authentication & Security Configuration
# AUTH_MODE options:
#   'token'    : (Primary Default) Authenticate via SERVER_AUTH_TOKEN secret. This is the default out-of-the-box mode. It works seamlessly in both Option A (Sandbox) and Option B (Host Passthrough).
#   'pam'      : Authenticate via Linux OS system users (PAM). Enables full multi-device terminal persistence and profile syncing. Works in *both* Option A (authenticating against the internal container OS user) and Option B (authenticating against your host Linux OS user).
#   'disabled' : Bypass authentication for isolated local dev.
AUTH_MODE=token
ENABLE_AUTH=true

# For out-of-the-box demonstration, this defaults to '1234' in docker-compose.yml.
# SECURITY WARNING: The token '1234' is entirely insecure! For prolonged usage, 
# especially when exposing the application over tunnels (Tailscale/Cloudflare) 
# or the public internet, you *must* change this to a highly secure cryptographic token!
SERVER_AUTH_TOKEN=1234
SUDO_MACRO_SECRET=your_secure_sudo_password

# If using Option B (Host Passthrough), run 'tmux -V' on your server and enter the exact version here.
TMUX_VERSION=3.6

# Deployment Mode Configuration
# The application supports three distinct architectural deployments:
#   1. sandbox (Fully Containerized): The default. Runs isolated in Docker with its own internal tmux and auth.
#   2. pass-through (Containerized): Runs in Docker, but maps the host's tmux socket to the container. 
#      If DEPLOYMENT_MODE=pass-through and TMUX_SOCKET_PATH is set, the UI will actively control the host's tmux server. 
#      This requires mapping /etc/passwd, /home, and the socket path via docker-compose.yml.
#   3. baremetal: Bypasses Docker entirely. Runs via Python Uvicorn natively on the host OS.
DEPLOYMENT_MODE=sandbox

# HTTPS / SSL Security Configuration
# Default: ENABLE_HTTPS=false (Runs HTTP on PORT for Tailscale Serve, Nginx Proxy Manager, or Cloudflare Tunnels)
# To enable direct HTTPS inside Uvicorn, set ENABLE_HTTPS=true and provide valid SSL certificate/key paths.
# See docs/HTTPS_AND_NETWORKING_GUIDE.md for complete Tailscale, Nginx, and SSL setup instructions.
ENABLE_HTTPS=false
SSL_CERT_PATH=./server/certs/cert.pem
SSL_KEY_PATH=./server/certs/key.pem
SSL_ORGANIZATION=OmniState

# Timezone Configuration (e.g. America/Chicago, America/New_York, Europe/Oslo, etc.)
TZ=America/Chicago

# File Deletion Safety Configuration
# Default: SAFE_TRASH_MODE=true moves deleted items to ./_temp_trash/
# Set ENABLE_PERMANENT_DELETE=true or SAFE_TRASH_MODE=false to allow permanent file removal
SAFE_TRASH_MODE=true
ENABLE_PERMANENT_DELETE=false
# TRASH_DIR is optional. Defaults to $SOVEREIGN_ROOT/_temp_trash if not set.
# TRASH_DIR=/home/user/projects/_temp_trash

# Video Playback Configuration
# FFmpeg is required for in-browser playback of non-native video formats (MKV, AVI, etc.)
# Docker image ships with FFmpeg pre-installed. Baremetal installs require: apt install ffmpeg
#
# Phase 2 (default): Pure remux for H.264/VP9/AV1 + AAC/Opus audio (near-instant, no quality loss)
#                    Hybrid remux for other audio codecs (video copy + audio → Opus, fast)
# Phase 3 (optional): Software transcode for HEVC/H.265, DivX, MPEG-2, and other formats.
#                     Requires significant CPU. Set ENABLE_ADVANCED_TRANSCODE=true to enable.
ENABLE_ADVANCED_TRANSCODE=false

# ── Phase 2b: Server-Side Video Cache ──────────────────────────────────────
# FFmpeg remux output is cached here so range-seeking and Plyr controls work.
# The cache is ephemeral (24h TTL) — not a media server, just a viewer aid.
# Leave VIDEO_CACHE_DIR blank to use server/_cache/ (relative to server dir).
VIDEO_CACHE_DIR=
VIDEO_CACHE_MAX_AGE_H=24
VIDEO_CACHE_MAX_GB=10
